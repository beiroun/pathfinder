# Pathfinder - the compose stack of this directory as one system service
# ======================================================================
# Install (see RUNBOOK.md "System service"): the unit is rendered with the real path of this directory, the
# committed file carries the canonical /opt/pathfinder/deployment.
#
#   systemctl start pathfinder     `docker compose up -d`
#   systemctl reload pathfinder    the same on a running system - after `git pull`, `docker compose pull` or an
#                                  edit of .env; changed services are recreated
#   systemctl stop pathfinder      `docker compose down`: containers removed, the postgres-data volume and every
#                                  file in this directory stay
#
# Containers keep `restart: always`, so Docker revives a crashed one by itself; the unit owns start/stop of the
# whole set. `down` on stop is deliberate: a stopped-but-present container with `restart: always` would be
# started again by the Docker daemon on the next boot even with the unit disabled.

[Unit]
Description=Pathfinder (QR redirect server, console, database, edge proxy)
Documentation=https://github.com/beiroun/pathfinder/blob/release/deployment/RUNBOOK.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/pathfinder/deployment
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecReload=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down
# The first start on a fresh host may pull every image
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
