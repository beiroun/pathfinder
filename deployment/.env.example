# Pathfinder - host environment (template)
# ========================================
# Copy to .env in this directory; docker compose reads it automatically. .env is gitignored - it holds the real
# names, the passwords and the console logins. Every value here is site-local; nothing in it is committed.

# ---- Public names and TLS (edge proxy) ----

# Both names must have an A record pointing at this host BEFORE the first start of the edge container: the
# certificate is issued over an HTTP challenge on port 80, and a name that does not resolve here fails it.

# The server: every printed QR code points at https://<PF_SERVER_HOST>/r/<slug>, and the API answers here too.
# Printed codes outlive deployments - choose a name you will keep.
PF_SERVER_HOST=pathfinder.example.com
# The management console (the web UI)
PF_CONSOLE_HOST=pathfinder-console.example.com
# Address the CA sends expiry notices to; also the ACME account identity
PF_ACME_EMAIL=admin@example.com

# Browser origins allowed to call the server API cross-site, comma-separated. Leave EMPTY for the standard
# deployment: the console reaches the API through its own nginx on its own name, which is same-origin and
# needs no CORS. Fill it only when a browser on another name calls the API directly (a console image built with
# API_BASE_URL). A wildcard is rejected by the server: the policy allows credentials.
PF_CORS_ORIGINS=

# ---- Database ----

# Password of the database user "pathfinder" (schema owner; the server runs the migrations as it):
# openssl rand -hex 24. Fixed by the first start - changing it later needs ALTER ROLE in the database as well.
PF_DB_PASSWORD=

# ---- Console access ----

# Signing key of the console's login tokens, at least 32 characters (openssl rand -hex 32). Changing it logs
# everybody out.
PF_JWT_SECRET=
# Console administrators (create, edit, delete codes) as login:password pairs, comma-separated. At least one.
# Login: 3-64 latin letters, digits, '.', '_', '-'. Password: at least 8 characters, no commas. The server creates
# or updates these accounts on every start and disables the ones removed from the list.
PF_ADMIN_USERS=admin:change-me-now
# Read-only users (see codes, statistics and images), same format. Optional.
PF_VIEWER_USERS=
# How long a console login lasts before a silent refresh / until it expires (ISO-8601 durations). Optional.
#PF_ACCESS_TOKEN_TTL=PT15M
#PF_REFRESH_TOKEN_TTL=P7D

# ---- Operations ----

# Log level of the server's own packages
PF_LOG_LEVEL=INFO
# Time zone of the containers: the console shows created/updated times as the server wrote them
PF_TZ=UTC
