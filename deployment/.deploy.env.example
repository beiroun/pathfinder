# SPDX-License-Identifier: BUSL-1.1
# Where deployment/push.sh sends the files and how it logs in. Copy to deployment/.deploy.env (gitignored): the
# real address, ssh port and key of the host stay out of this public repository. A variable exported in the shell
# overrides the file for one call.

# user@host of the server
PF_DEPLOY_TARGET=root@pathfinder.example.com
# ssh port of the host
PF_DEPLOY_PORT=22
# the umbrella's deployment/ directory on the host - the checkout the system service was installed from
PF_DEPLOY_DIR=/opt/pathfinder/deployment

# Login. A key is the clean way - make one and put it on the host once:
#   ssh-keygen -t ed25519 -f ~/.ssh/pathfinder -N ''
#   ssh-copy-id -i ~/.ssh/pathfinder.pub -p 22 root@pathfinder.example.com     (asks the password this one time)
# sftp runs in batch mode and cannot ask for a password, so without a key the ssh agent has to hold one that
# the host accepts.
PF_DEPLOY_KEY=~/.ssh/pathfinder
# Fallback instead of a key: a password, passed through sshpass (brew install hudochenkov/sshpass/sshpass).
# Leave empty when a key is used.
PF_DEPLOY_PASSWORD=
